# Frontend / API runtime configuration
TEAMSYNC_PORT=3001
TEAMSYNC_ALLOWED_ORIGINS=http://localhost:4173,http://localhost:5173,http://localhost:4180
TEAMSYNC_PERSIST=false
# Persistence backends (checked in this order):
#   postgres -> DATABASE_URL present (and TEAMSYNC_USE_SQLITE != true).
#               TEAMSYNC_USE_POSTGRES=true also forces it.
#   sqlite   -> TEAMSYNC_USE_SQLITE=true + TEAMSYNC_DATABASE_PATH (local/tests)
#   json     -> TEAMSYNC_DATA_FILE (default)
TEAMSYNC_USE_POSTGRES=false
TEAMSYNC_USE_SQLITE=false
TEAMSYNC_DATA_FILE=./server/.data/users.json
TEAMSYNC_DATABASE_PATH=./server/.data/teamsync.db

# Auth
# Required in production. The API refuses to start without it when NODE_ENV=production.
# SESSION_SECRET=replace-with-a-strong-random-value

# Logging (debug | info | warn | error)
LOG_LEVEL=info
# Optional external error tracker (Sentry relay, Datadog, custom webhook)
# ERROR_REPORTING_URL=https://hooks.example.com/errors

# Backups (server/backup.js)
TEAMSYNC_BACKUP_DIR=./server/.data/backups
TEAMSYNC_BACKUP_KEEP=14

# Email delivery — leave EMAIL_PROVIDER unset to log messages to console instead
# EMAIL_PROVIDER=resend | mailgun | smtp
# EMAIL_FROM="TeamSync <noreply@teamsync.app>"
# RESEND_API_KEY=
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Public app URL used in email links (reset/invite). Falls back to VERCEL_URL.
# TEAMSYNC_APP_URL=https://yourdomain.com

# Frontend (Vite). In production set this to the hosted API origin so the
# static frontend can reach the API cross-origin.
# VITE_API_BASE_URL=https://teamsync-api.onrender.com

# Production deployment values
# TEAMSYNC_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# TEAMSYNC_PERSIST=true
# TEAMSYNC_USE_SQLITE=false
# DATABASE_URL=postgres://user:password@host:5432/teamsync